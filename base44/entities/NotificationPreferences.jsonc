{
  "name": "NotificationPreferences",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "userEmail": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "notifyTaskAssigned": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05db\u05d0\u05e9\u05e8 \u05de\u05e9\u05d9\u05de\u05d4 \u05de\u05d5\u05e7\u05e6\u05d9\u05ea \u05d0\u05dc\u05d9\u05d9"
    },
    "notifyAwaitingApproval": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05db\u05d0\u05e9\u05e8 \u05de\u05e9\u05d9\u05de\u05d4 \u05de\u05de\u05ea\u05d9\u05e0\u05d4 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8\u05d9 (\u05dc\u05de\u05e0\u05d4\u05dc)"
    },
    "notifyFaultClosed": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05db\u05d0\u05e9\u05e8 \u05ea\u05e7\u05dc\u05d4 \u05e9\u05d3\u05d9\u05d5\u05d5\u05d7\u05ea\u05d9 \u05e0\u05e1\u05d2\u05e8\u05d4"
    },
    "notifyNewFault": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05e2\u05dc \u05ea\u05e7\u05dc\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05e9\u05e0\u05d3\u05d5\u05d5\u05d7\u05d4 (\u05dc\u05de\u05e0\u05d4\u05dc)"
    }
  },
  "required": [
    "userId",
    "userEmail"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
                "\u05de\u05e4\u05ea\u05d7"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
                "\u05de\u05e4\u05ea\u05d7"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "userId": "{{user.id}}"
    }
  }
}
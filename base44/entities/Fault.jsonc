{
  "name": "Fault",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05e7\u05e6\u05e8\u05d4 \u05dc\u05ea\u05e7\u05dc\u05d4 (2-3 \u05de\u05d9\u05dc\u05d9\u05dd, \u05e0\u05d5\u05e6\u05e8\u05ea \u05e2\"\u05d9 AI)"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05ea\u05e7\u05dc\u05d4 (\u05e9\u05dd \u05de\u05d9\u05e7\u05d5\u05dd \u05de\u05d0\u05d5\u05d7\u05d3)"
    },
    "roomNumber": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05d3\u05e8 / \u05db\u05d9\u05ea\u05d4 (\u05de\u05d7\u05d5\u05dc\u05e5 \u05e2\"\u05d9 AI)"
    },
    "faultType": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05e7\u05dc\u05d4 (\u05de\u05e1\u05d5\u05d5\u05d2 \u05e2\"\u05d9 AI)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05ea\u05e7\u05dc\u05d4"
    },
    "image": {
      "type": "string",
      "description": "URL \u05e9\u05dc \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05ea\u05e7\u05dc\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea"
    },
    "repairImage": {
      "type": "string",
      "description": "URL \u05e9\u05dc \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05ea\u05d9\u05e7\u05d5\u05df \u05e9\u05e6\u05d5\u05dc\u05de\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05df",
        "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc",
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8",
        "\u05e1\u05d2\u05d5\u05e8"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05df",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05e7\u05dc\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "\u05d2\u05d1\u05d5\u05d4\u05d4",
        "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea",
        "\u05dc\u05d0 \u05de\u05d5\u05d2\u05d3\u05e8"
      ],
      "default": "\u05dc\u05d0 \u05de\u05d5\u05d2\u05d3\u05e8",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d4\u05ea\u05e7\u05dc\u05d4"
    },
    "assignedTo": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05de\u05d5\u05e0\u05d4 \u05dc\u05ea\u05e7\u05dc\u05d4"
    },
    "reportedBy": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d4\u05ea\u05e7\u05dc\u05d4"
    }
  },
  "required": [
    "location",
    "faultType",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "\u05e6\u05d5\u05d5\u05ea \u05de\u05d3\u05d5\u05d5\u05d7",
            "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
            "\u05de\u05e4\u05ea\u05d7",
            "\u05d0\u05d1 \u05d1\u05d9\u05ea"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
                "\u05de\u05e4\u05ea\u05d7"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "\u05d0\u05d1 \u05d1\u05d9\u05ea"
          }
        },
        {
          "reportedBy": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "assignedTo": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
                "\u05de\u05e4\u05ea\u05d7"
              ]
            }
          }
        },
        {
          "reportedBy": "{{user.email}}"
        },
        {
          "assignedTo": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
            "\u05de\u05e4\u05ea\u05d7"
          ]
        }
      }
    }
  }
}
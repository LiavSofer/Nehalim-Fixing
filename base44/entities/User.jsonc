{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05e2\u05e8\u05db\u05ea \u05de\u05d5\u05d1\u05e0\u05d4"
    },
    "userType": {
      "type": "string",
      "enum": [
        "\u05dc\u05dc\u05d0 \u05d4\u05e8\u05e9\u05d0\u05d4",
        "\u05e6\u05d5\u05d5\u05ea \u05de\u05d3\u05d5\u05d5\u05d7",
        "\u05d0\u05d1 \u05d1\u05d9\u05ea",
        "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
        "\u05de\u05e0\u05d4\u05dc \u05de\u05d5\u05e1\u05d3",
        "\u05de\u05e4\u05ea\u05d7"
      ],
      "default": "\u05dc\u05dc\u05d0 \u05d4\u05e8\u05e9\u05d0\u05d4",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "displayName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05e6\u05d5\u05d2\u05d4 \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05d6\u05d9\u05df \u05d1\u05d8\u05d5\u05e4\u05e1"
    },
    "profileImage": {
      "type": "string",
      "description": "URL \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc"
    },
    "profileCompleted": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d9\u05dc\u05d0 \u05d0\u05ea \u05e4\u05e8\u05d8\u05d9 \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc",
      "default": false
    }
  },
  "required": []
}
{
  "name": "Location",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d9\u05e7\u05d5\u05dd"
    },
    "type": {
      "type": "string",
      "enum": [
        "dormitory",
        "classBuilding",
        "other"
      ],
      "default": "other",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d9\u05e7\u05d5\u05dd: \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05d4, \u05d1\u05e0\u05d9\u05d9\u05df \u05db\u05d9\u05ea\u05d5\u05ea, \u05d0\u05d7\u05e8"
    },
    "order": {
      "type": "number",
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e6\u05d2\u05d4"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
            "\u05de\u05e4\u05ea\u05d7"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
            "\u05de\u05e4\u05ea\u05d7"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
            "\u05de\u05e4\u05ea\u05d7"
          ]
        }
      }
    }
  }
}
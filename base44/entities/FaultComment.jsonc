{
  "name": "FaultComment",
  "type": "object",
  "properties": {
    "faultId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05ea\u05e7\u05dc\u05d4"
    },
    "comment": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "userId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05db\u05ea\u05d1 \u05d0\u05ea \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "userName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "userProfileImage": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "type": {
      "type": "string",
      "enum": [
        "manual",
        "automatic"
      ],
      "default": "manual",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05e2\u05e8\u05d4: \u05d9\u05d3\u05e0\u05d9\u05ea \u05d0\u05d5 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
    },
    "automaticEventType": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9: assigned, repaired, closed"
    }
  },
  "required": [
    "faultId",
    "comment"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "\u05de\u05e0\u05d4\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4",
            "\u05de\u05e4\u05ea\u05d7"
          ]
        }
      }
    }
  }
}